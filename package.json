{
  "name": "sauce-labs-automation",
  "version": "1.0.0",
  "description": "BDD automation tests for Sauce Labs using Playwright and Cucumber",
  "scripts": {
    "test": "cucumber-js",
    "test:headed": "HEADED=true cucumber-js",
    "test:debug": "HEADED=true cucumber-js --format progress-bar --publish-quiet",
    "test:report": "cucumber-js --format html:cucumber-report.html && start cucumber-report.html"
  },
  "keywords": [
    "automation",
    "testing",
    "bdd",
    "cucumber",
    "playwright"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
